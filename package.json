{
  "name": "@accountability/discovery-acquisition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./collection": {
      "types": "./dist/collection.d.ts",
      "default": "./dist/collection.js"
    },
    "./connectors": {
      "types": "./dist/connectors.d.ts",
      "default": "./dist/connectors.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./catalog-traversal": {
      "types": "./dist/catalog-traversal.d.ts",
      "default": "./dist/catalog-traversal.js"
    },
    "./catalog-checkpoint": {
      "types": "./dist/catalog-checkpoint.d.ts",
      "default": "./dist/catalog-checkpoint.js"
    },
    "./archive-formats": {
      "types": "./dist/archive-formats.d.ts",
      "default": "./dist/archive-formats.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./serve": {
      "types": "./dist/engine/serve.d.ts",
      "default": "./dist/engine/serve.js"
    },
    "./service-kit": {
      "types": "./dist/service-kit.d.ts",
      "default": "./dist/service-kit.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-pr-registry.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck:postgres": "tsc --noEmit -p tsconfig.postgres.json",
    "test:postgres": "npm run typecheck:postgres && node --test integration/postgres-scheduler.test.ts",
    "serve": "node src/engine/serve.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "@accountability/evidence": "git+https://github.com/Justice-For-All-Movement/evidence-storage-and-provenance-engine.git#dce7105a70b42d77afe4cd48d34723331447037c",
    "pg": "8.23.1"
  }
}
